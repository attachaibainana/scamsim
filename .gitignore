# ScamSim: secrets and research logs never go to git
# config.json holds the API key. It lives at the project root (next to the .exe in a build) and is
# never inside Assets, because everything under StreamingAssets is copied into every build.
/config.json
/Assets/StreamingAssets/config.json
/Assets/StreamingAssets/config.json.meta
/Logs/

# Style references from other games: kept on this machine only, never published in this public repo.
/Art/ref/

# Raw images from Codex (tools/art/gen.ps1). Only the processed copies under Assets/Art go to git;
# the prompts in Art/gen/prompts regenerate them.
/Art/gen/raw/

# OS
.DS_Store
Thumbs.db
