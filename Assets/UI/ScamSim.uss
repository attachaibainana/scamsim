/*
 * ScamSim — one style sheet for every screen.
 * Layout (PRD 2.7, update 2026-11-17): a 16:9 visual-novel stage, 1422x800, scaled to fit the window
 * by the panel settings. Painted scenes and characters (Assets/Art) sit behind the UI.
 * UI rules kept from the first design: rounded shapes, one outline width (4px), outline darker than
 * its fill, scammer = red/orange, player = mint/blue, one accent (yellow). Text >= 18px at 800px high.
 */

/* ---- Root and stage ---------------------------------------------------------------------- */

.scamsim-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    -unity-font: url("/Assets/Fonts/IBMPlexSansThaiLooped-Regular.ttf");
    font-size: 24px;
    color: rgb(245, 247, 250);
    background-color: rgb(8, 9, 16);
}

.stage {
    width: 1422px;
    height: 800px;
    flex-shrink: 0;
    overflow: hidden;
    background-color: rgb(16, 19, 33);
}

.screen {
    flex-grow: 1;
}

.bold {
    -unity-font: url("/Assets/Fonts/IBMPlexSansThaiLooped-Bold.ttf");
}

.title {
    font-size: 44px;
    -unity-text-align: middle-center;
    white-space: normal;
    margin-bottom: 16px;
}

.body {
    font-size: 24px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.small {
    font-size: 18px;
    white-space: normal;
    color: rgb(170, 178, 204);
}

.hidden {
    display: none;
}

/* ---- Scene layers -------------------------------------------------------------------------- */

.scene {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.scene.street { background-image: url("/Assets/Art/Backgrounds/bg_street.png"); }
.scene.living-room { background-image: url("/Assets/Art/Backgrounds/bg_living_room.png"); }
.scene.call-center { background-image: url("/Assets/Art/Backgrounds/bg_call_center.png"); }

.shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 22, 0.62);
}

.shade.soft {
    background-color: rgba(8, 10, 22, 0.22);
}

/* A character standing on the bottom edge of the stage. */
.sprite {
    position: absolute;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.pip {
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.pip-happy { background-image: url("/Assets/Art/Characters/pip_happy.png"); }
.pip-worried { background-image: url("/Assets/Art/Characters/pip_worried.png"); }

.panel {
    background-color: rgba(18, 22, 40, 0.9);
    border-width: 4px;
    border-color: rgb(60, 68, 104);
    border-radius: 28px;
}

/* PIP's speech bubble. */
.say-bubble {
    flex-shrink: 0;
    max-width: 440px;
    background-color: rgb(250, 248, 240);
    border-width: 4px;
    border-color: rgb(60, 68, 104);
    border-radius: 26px;
    padding: 12px 20px;
    margin-bottom: 12px;
}

.say-text {
    white-space: normal;
    font-size: 24px;
    color: rgb(28, 30, 46);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* ---- Buttons ----------------------------------------------------------------------------- */

Button {
    -unity-font: url("/Assets/Fonts/IBMPlexSansThaiLooped-Bold.ttf");
    font-size: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
    border-width: 4px;
    border-radius: 28px;
    padding: 14px 24px;
    margin: 8px 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

Button:active {
    scale: 0.96 0.96;
}

.primary-button {
    background-color: rgb(255, 200, 61);
    border-color: rgb(176, 124, 12);
    color: rgb(48, 32, 4);
    min-height: 72px;
}

.primary-button:hover {
    background-color: rgb(255, 214, 104);
}

.secondary-button {
    background-color: rgb(52, 58, 92);
    border-color: rgb(28, 32, 56);
    color: rgb(240, 242, 250);
    min-height: 60px;
}

.secondary-button:hover {
    background-color: rgb(66, 74, 112);
}

.option-button {
    background-color: rgb(244, 240, 232);
    border-color: rgb(84, 90, 124);
    color: rgb(28, 30, 46);
    -unity-font: url("/Assets/Fonts/IBMPlexSansThaiLooped-Regular.ttf");
    font-size: 24px;
    -unity-text-align: middle-left;
    min-height: 64px;
    margin: 6px 0;
}

.option-button:hover {
    background-color: rgb(255, 252, 244);
    border-color: rgb(102, 214, 170);
}

.button-row {
    flex-direction: row;
    flex-shrink: 0;
}

.button-row > .secondary-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px;
}

/* ---- Intro ------------------------------------------------------------------------------- */

.intro-guide {
    position: absolute;
    left: 60px;
    bottom: 36px;
    width: 560px;
    height: 700px;
    align-items: center;
    justify-content: flex-end;
}

.intro-pip {
    width: 380px;
    height: 420px;
}

.intro-panel {
    position: absolute;
    right: 56px;
    top: 56px;
    bottom: 56px;
    width: 660px;
    padding: 24px 40px;
    justify-content: center;
}

/* ---- Call: ringing ----------------------------------------------------------------------- */

.call {
    padding: 0;
}

.ringing {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
}

.ring-card {
    width: 540px;
    padding: 36px 36px 28px 36px;
    align-items: center;
    background-color: rgba(18, 22, 40, 0.92);
    border-width: 4px;
    border-color: rgb(60, 68, 104);
    border-radius: 36px;
}

.caption {
    font-size: 24px;
    color: rgb(190, 198, 222);
    margin-bottom: 20px;
}

/* The caller is still unknown: a dark circle with a red edge that pulses while it rings. */
.ring-avatar {
    width: 168px;
    height: 168px;
    border-radius: 84px;
    border-width: 6px;
    border-color: rgb(255, 72, 72);
    background-color: rgb(10, 10, 14);
    justify-content: center;
    align-items: center;
    transition-property: scale, border-color;
    transition-duration: 0.5s;
}

.ring-avatar.pulse {
    scale: 1.08 1.08;
    border-color: rgb(255, 150, 130);
}

.ring-avatar-mark {
    font-size: 84px;
    color: rgb(255, 96, 80);
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.caller {
    font-size: 36px;
    margin-top: 20px;
    -unity-text-align: middle-center;
}

.ring-buttons {
    flex-direction: row;
    justify-content: space-between;
    align-self: stretch;
    margin-top: 36px;
}

.round-button {
    width: 210px;
    min-height: 80px;
    border-radius: 40px;
    color: rgb(255, 255, 255);
}

.round-button.accept {
    background-color: rgb(64, 186, 104);
    border-color: rgb(28, 116, 60);
}

.round-button.decline,
.hangup-button {
    background-color: rgb(226, 68, 68);
    border-color: rgb(146, 30, 30);
    color: rgb(255, 255, 255);
}

/* ---- Call: on the line -------------------------------------------------------------------- */

.in-call {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The caller as he presents himself; his face follows the pressure level (CallScreen.SetPressure). */
.caller-sprite {
    left: 200px;
    width: 470px;
    height: 780px;
}

.caller-sprite.expr-calm { background-image: url("/Assets/Art/Characters/police_calm.png"); }
.caller-sprite.expr-stern { background-image: url("/Assets/Art/Characters/police_stern.png"); }
.caller-sprite.expr-angry { background-image: url("/Assets/Art/Characters/police_angry.png"); }

/* Pressure 1..5: the room gets redder as the scammer pushes harder. */
.pressure-tint {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(170, 20, 30, 0);
    transition-property: background-color;
    transition-duration: 0.8s;
}

.call.pressure-1 .pressure-tint { background-color: rgba(170, 20, 30, 0); }
.call.pressure-2 .pressure-tint { background-color: rgba(170, 20, 30, 0.06); }
.call.pressure-3 .pressure-tint { background-color: rgba(170, 20, 30, 0.14); }
.call.pressure-4 .pressure-tint { background-color: rgba(170, 20, 30, 0.24); }
.call.pressure-5 .pressure-tint { background-color: rgba(170, 20, 30, 0.34); }

.call-topbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 16px 24px 0 24px;
}

.call-status {
    flex-grow: 1;
    flex-direction: row;
}

.call-status-pill {
    flex-direction: row;
    align-items: center;
    padding: 6px 20px;
    background-color: rgba(18, 22, 40, 0.88);
    border-width: 4px;
    border-color: rgb(60, 68, 104);
    border-radius: 26px;
}

.live-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: rgb(255, 72, 72);
    margin-right: 12px;
}

.call-status-text {
    font-size: 22px;
    margin: 0;
    padding: 0;
}

.topbar-button {
    margin: 0 0 0 12px;
    min-height: 56px;
    padding: 6px 22px;
    font-size: 22px;
}

.call-middle {
    flex-grow: 1;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-end;
    padding: 12px 24px 0 24px;
}

.answer-area {
    width: 560px;
    padding: 12px 16px 8px 16px;
    background-color: rgba(18, 22, 40, 0.88);
    border-width: 4px;
    border-color: rgb(60, 68, 104);
    border-radius: 26px;
}

.answer-hint {
    font-size: 20px;
    color: rgb(200, 206, 226);
    margin-bottom: 2px;
}

/* The dialogue box: the newest line, and the place to type a reply. */
.dialogue-box {
    flex-shrink: 0;
    min-height: 168px;
    margin: 20px 24px 20px 24px;
    padding: 30px 32px 20px 32px;
    background-color: rgba(14, 18, 34, 0.93);
    border-width: 4px;
    border-color: rgb(84, 90, 124);
    border-radius: 26px;
}

.name-tag {
    position: absolute;
    top: -24px;
    left: 28px;
    padding: 2px 18px 4px 18px;
    font-size: 22px;
    border-width: 4px;
    border-radius: 18px;
    background-color: rgb(255, 128, 92);
    border-color: rgb(178, 66, 40);
    color: rgb(44, 14, 6);
}

.name-tag.you {
    background-color: rgb(118, 226, 196);
    border-color: rgb(40, 140, 110);
    color: rgb(8, 40, 32);
}

.dialogue-line {
    font-size: 28px;
    white-space: normal;
    color: rgb(245, 247, 250);
    margin: 0;
    padding: 0;
}

.dialogue-line.notice {
    color: rgb(200, 206, 226);
}

.typing {
    font-size: 22px;
    color: rgb(255, 170, 150);
    margin: 8px 0 0 0;
    padding: 0;
}

.free-text-row {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.free-text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 10px 0 0;
}

.free-text > .unity-text-field__input,
.free-text .unity-base-text-field__input {
    min-height: 60px;
    font-size: 24px;
    border-width: 4px;
    border-radius: 20px;
    border-color: rgb(84, 90, 124);
    background-color: rgb(244, 240, 232);
    color: rgb(28, 30, 46);
    padding: 6px 14px;
    -unity-font: url("/Assets/Fonts/IBMPlexSansThaiLooped-Regular.ttf");
}

.send-button {
    margin: 0;
    min-height: 60px;
    min-width: 110px;
    background-color: rgb(102, 196, 232);
    border-color: rgb(30, 116, 156);
    color: rgb(6, 30, 44);
}

.dropped {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 12px;
}

.dropped-text {
    margin: 0;
}

.call-footer {
    align-items: flex-end;
    margin-top: 12px;
}

.call-footer .primary-button {
    min-width: 320px;
    margin: 0;
}

/* The call history, opened from the top bar: every line so far as chat bubbles. It sits in the
   middle band (between the top bar and the dialogue box), left of the answers, so it never covers them. */
.history {
    position: absolute;
    left: 24px;
    top: 12px;
    bottom: 0;
    width: 680px;
    background-color: rgba(14, 18, 34, 0.97);
    border-width: 4px;
    border-color: rgb(84, 90, 124);
    border-radius: 26px;
}

.messages .unity-scroll-view__content-container {
    padding: 20px 20px 8px 20px;
}

/* Scroll bars: a slim rounded thumb in the panel colours instead of the default grey bar with arrows. */
.unity-scroller--vertical {
    width: 16px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin: 14px 4px 14px 0;
}

.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.06);
    border-width: 0;
    border-radius: 6px;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(96, 104, 144);
    border-width: 0;
    border-radius: 6px;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(255, 200, 61);
}

.bubble {
    flex-shrink: 0;
    max-width: 85%;
    border-width: 4px;
    border-radius: 26px;
    padding: 12px 18px;
    margin-bottom: 14px;
    font-size: 24px;
}

.bubble-text {
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* Set the text colour on the label itself, so the theme's label colour cannot win over inheritance. */
.bubble.scammer .bubble-text { color: rgb(44, 14, 6); }
.bubble.player .bubble-text { color: rgb(8, 40, 32); }
.bubble.system .bubble-text { color: rgb(220, 226, 240); font-size: 20px; }

.bubble.scammer {
    align-self: flex-start;
    background-color: rgb(255, 128, 92);
    border-color: rgb(178, 66, 40);
    border-bottom-left-radius: 6px;
}

.bubble.player {
    align-self: flex-end;
    background-color: rgb(118, 226, 196);
    border-color: rgb(40, 140, 110);
    border-bottom-right-radius: 6px;
}

.bubble.system {
    align-self: center;
    background-color: rgba(0, 0, 0, 0.35);
    border-color: rgba(0, 0, 0, 0.5);
}

/* ---- News -------------------------------------------------------------------------------- */

.news {
    position: absolute;
    left: 160px;
    right: 160px;
    top: 28px;
    bottom: 28px;
    padding: 20px 24px 0 24px;
}

.news-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.back-button {
    margin: 0 16px 0 0;
    min-height: 56px;
    padding: 8px 20px;
}

.news-title {
    font-size: 36px;
    flex-grow: 1;
}

.news-status {
    margin: 8px 0 4px 0;
    flex-shrink: 0;
}

.filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.filter-chip {
    font-size: 20px;
    min-height: 48px;
    padding: 6px 16px;
    margin: 6px 8px 0 0;
    border-radius: 24px;
    background-color: rgb(38, 44, 74);
    border-color: rgb(84, 90, 124);
    color: rgb(220, 226, 240);
}

.filter-chip:hover {
    border-color: rgb(255, 200, 61);
}

.filter-chip.selected {
    background-color: rgb(255, 200, 61);
    border-color: rgb(176, 124, 12);
    color: rgb(48, 32, 4);
}

.news-list {
    flex-grow: 1;
    flex-shrink: 1;
}

.news-card {
    flex-shrink: 0;
    border-width: 4px;
    border-radius: 22px;
    border-color: rgb(52, 58, 92);
    background-color: rgb(32, 37, 64);
    padding: 14px 18px;
    margin-bottom: 14px;
}

.news-card-top {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.news-date {
    font-size: 18px;
    color: rgb(170, 178, 204);
    margin: 0;
    padding: 0;
}

.news-tag {
    border-width: 4px;
    border-radius: 14px;
    padding: 0 12px 2px 12px;
    background-color: rgb(255, 128, 92);
    border-color: rgb(178, 66, 40);
}

.news-tag-text {
    font-size: 18px;
    color: rgb(44, 14, 6);
    margin: 0;
    padding: 0;
}

/* One colour per scam type, so the list can be scanned at a glance. */
.news-tag.type-romance { background-color: rgb(255, 154, 190); border-color: rgb(176, 70, 112); }
.news-tag.type-investment { background-color: rgb(255, 200, 61); border-color: rgb(176, 124, 12); }
.news-tag.type-parcel { background-color: rgb(196, 160, 255); border-color: rgb(108, 72, 176); }
.news-tag.type-job { background-color: rgb(102, 196, 232); border-color: rgb(30, 116, 156); }
.news-tag.type-loan { background-color: rgb(170, 226, 120); border-color: rgb(84, 140, 40); }
.news-tag.type-other { background-color: rgb(200, 204, 220); border-color: rgb(110, 116, 140); }

.news-headline {
    -unity-font: url("/Assets/Fonts/IBMPlexSansThaiLooped-Bold.ttf");
    font-size: 26px;
    white-space: normal;
    margin: 8px 0 4px 0;
    padding: 0;
}

.news-summary {
    font-size: 21px;
    white-space: normal;
    color: rgb(214, 220, 236);
    margin: 0;
    padding: 0;
}

.news-facts {
    font-size: 18px;
    white-space: normal;
    color: rgb(255, 196, 176);
    margin: 8px 0 0 0;
    padding: 0;
}

.news-card .button-row > .secondary-button {
    font-size: 20px;
    min-height: 52px;
}

/* ---- Debrief ----------------------------------------------------------------------------- */

/* The reveal: who really called, in the call-centre room. */
/* Shorter than the caller on the phone, so his head stays clear of the caption above it. */
.reveal-sprite {
    left: 120px;
    width: 420px;
    height: 650px;
}

.reveal-sprite.real-smug { background-image: url("/Assets/Art/Characters/scammer_real_smug.png"); }
.reveal-sprite.real-annoyed { background-image: url("/Assets/Art/Characters/scammer_real_annoyed.png"); }

.reveal-caption {
    position: absolute;
    left: 28px;
    top: 28px;
    width: 600px;
    font-size: 24px;
    white-space: normal;
    padding: 10px 20px 12px 20px;
    background-color: rgba(18, 22, 40, 0.9);
    border-width: 4px;
    border-color: rgb(178, 66, 40);
    border-radius: 22px;
    color: rgb(255, 196, 176);
}

.debrief-guide {
    position: absolute;
    left: 24px;
    bottom: 20px;
    width: 620px;
    flex-direction: row;
    align-items: flex-end;
}

.debrief-pip {
    width: 190px;
    height: 210px;
}

.say-bubble.left {
    max-width: 400px;
    margin: 0 0 120px 4px;
}

.debrief-scroll {
    position: absolute;
    right: 36px;
    top: 28px;
    bottom: 28px;
    width: 720px;
}

.debrief {
    padding: 24px 32px 40px 32px;
}

.lost {
    color: rgb(255, 170, 150);
}

.score {
    font-size: 30px;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.legend {
    margin-bottom: 10px;
}

.timeline-item {
    flex-shrink: 0;
    border-width: 4px;
    border-radius: 20px;
    border-color: rgb(52, 58, 92);
    background-color: rgb(32, 37, 64);
    padding: 12px 16px;
    margin-bottom: 10px;
}

.timeline-line {
    white-space: normal;
    font-size: 22px;
    color: rgb(255, 196, 176);
    margin: 0;
    padding: 0;
}

.timeline-reply {
    white-space: normal;
    font-size: 20px;
    color: rgb(170, 226, 206);
    margin: 8px 0 0 0;
    padding: 0;
}

.flag-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.flag-chip {
    flex-shrink: 0;
    max-width: 100%;
    border-width: 4px;
    border-radius: 16px;
    padding: 2px 12px 4px 12px;
    margin: 6px 6px 0 0;
}

.flag-chip-text {
    white-space: normal;
    font-size: 18px;
    margin: 0;
    padding: 0;
}

.flag-chip.noticed {
    background-color: rgb(118, 226, 196);
    border-color: rgb(40, 140, 110);
}

.flag-chip.missed {
    background-color: rgb(255, 128, 92);
    border-color: rgb(178, 66, 40);
}

.flag-chip.ended {
    background-color: rgb(120, 126, 156);
    border-color: rgb(72, 78, 108);
}

.flag-chip.noticed .flag-chip-text { color: rgb(8, 40, 32); }
.flag-chip.missed .flag-chip-text { color: rgb(44, 14, 6); }
.flag-chip.ended .flag-chip-text { color: rgb(240, 242, 250); }

.result-title {
    font-size: 56px;
    -unity-text-align: middle-center;
    border-width: 4px;
    border-radius: 32px;
    padding: 12px 20px;
    margin-bottom: 16px;
}

.result-title.scammed {
    background-color: rgb(255, 128, 92);
    border-color: rgb(178, 66, 40);
    color: rgb(44, 14, 6);
}

.result-title.escaped,
.result-title.hung_up {
    background-color: rgb(118, 226, 196);
    border-color: rgb(40, 140, 110);
    color: rgb(8, 40, 32);
}

.section-title {
    font-size: 28px;
    margin-top: 16px;
    margin-bottom: 8px;
}

.lesson {
    font-size: 24px;
    white-space: normal;
    padding: 12px 16px;
    margin-bottom: 10px;
    border-width: 4px;
    border-radius: 20px;
    border-color: rgb(52, 58, 92);
    background-color: rgb(38, 44, 74);
}

.debrief .primary-button {
    margin-top: 20px;
}

.log-path {
    margin-top: 12px;
    -unity-text-align: middle-center;
}
