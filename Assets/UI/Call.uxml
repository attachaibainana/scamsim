<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="call" class="screen vn call pressure-2">
        <ui:VisualElement class="scene living-room" picking-mode="Ignore" />

        <!-- Before answering: the room goes dark and the phone rings. -->
        <ui:VisualElement name="ringing" class="ringing">
            <ui:VisualElement class="shade" picking-mode="Ignore" />
            <ui:VisualElement class="ring-card">
                <ui:Label class="caption" text="@call.incoming" />
                <ui:VisualElement name="ring-avatar" class="ring-avatar">
                    <ui:Label class="ring-avatar-mark bold" text="?" />
                </ui:VisualElement>
                <ui:Label class="caller bold" text="@call.caller_unknown" />
                <ui:VisualElement class="ring-buttons">
                    <ui:Button name="decline" class="round-button decline" text="@call.decline" />
                    <ui:Button name="accept" class="round-button accept" text="@call.accept" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- On the call: the caller as he presents himself, the latest line in the dialogue box,
             the answers on the right. The red tint deepens with the pressure level. -->
        <ui:VisualElement name="in-call" class="in-call hidden">
            <ui:VisualElement name="caller-sprite" class="sprite caller-sprite expr-calm" picking-mode="Ignore" />
            <ui:VisualElement class="pressure-tint" picking-mode="Ignore" />

            <ui:VisualElement class="call-topbar">
                <ui:VisualElement class="call-status">
                    <ui:VisualElement class="call-status-pill">
                        <ui:VisualElement class="live-dot" />
                        <ui:Label class="call-status-text bold" text="@call.in_call" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="history-toggle" class="secondary-button topbar-button" text="@call.history" />
                <ui:Button name="hangup" class="hangup-button topbar-button" text="@call.hangup" />
            </ui:VisualElement>

            <ui:VisualElement class="call-middle" picking-mode="Ignore">
                <!-- Every line of the call, opened from the top bar. It fills the space above the
                     dialogue box, so the newest line and the reply field always stay visible. -->
                <ui:ScrollView name="messages" class="messages history hidden" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                <ui:VisualElement name="answer-area" class="answer-area hidden">
                    <ui:Label class="answer-hint" text="@call.choose_or_type" />
                    <ui:VisualElement name="options" class="options" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="dialogue-box">
                <ui:Label name="speaker" class="name-tag bold hidden" />
                <ui:Label name="line" class="dialogue-line" />
                <ui:Label name="typing" class="typing hidden" />
                <ui:VisualElement name="free-text-row" class="free-text-row hidden">
                    <ui:TextField name="free-text" class="free-text" max-length="300" />
                    <ui:Button name="send" class="send-button" text="@call.send" />
                </ui:VisualElement>
                <ui:VisualElement name="dropped" class="dropped hidden">
                    <ui:Label class="body dropped-text" text="@call.dropped" />
                    <ui:Button name="retry" class="primary-button" text="@call.retry" />
                </ui:VisualElement>
                <ui:VisualElement name="call-footer" class="call-footer hidden">
                    <ui:Button name="see-result" class="primary-button" text="@call.see_result" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
