<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="news" class="screen news">
        <ui:VisualElement class="news-header">
            <ui:Button name="back" class="secondary-button back-button" text="@news.back" />
            <ui:Label class="news-title bold" text="@news.title" />
        </ui:VisualElement>
        <ui:Label name="news-status" class="small news-status" />
        <ui:VisualElement name="filters" class="filter-row" />
        <ui:ScrollView name="news-list" class="news-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
    </ui:VisualElement>
</ui:UXML>
